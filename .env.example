# Web application
APP_HOST=http://127.0.0.1
APP_PORT=8000
ASSETS_PORT=5173
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=coderx
PGUSER=postgres
PGPASSWORD=

# Socket.IO: Redis is optional for local single-instance development.
SOCKET_PORT=8001
PRESENCE_STORE=memory
SOCKET_REDIS_ADAPTER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=coderx

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/oauth/github/callback

# Ollama / OpenAI-compatible model service (optional)
OLLAMA_HOST=http://127.0.0.1
OLLAMA_PORT=11434
AI_ALLOWED_MODELS=qwen2.5:7b
AI_ENABLE_TOOLS=false

# AI content ingest: scheduled work and run auto-publication are off.
# These flags do not disable explicit mutating CLI commands.
# Ingest uses this independent full model URL (not OLLAMA_HOST).
INGEST_ENABLED=false
INGEST_AUTO_PUBLISH=false
INGEST_CRON=15 7 * * *
INGEST_TIMEZONE=Asia/Shanghai
INGEST_DAILY_LIMIT=10
INGEST_DAYS=30
INGEST_HTTP_TIMEOUT_MS=15000
INGEST_AUTHOR_NAME=
INGEST_AUTHOR_IDS=
INGEST_TAG_NAME=人工智能
INGEST_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
INGEST_OLLAMA_MODEL=qwen2.5:7b

# Media storage migration: safe defaults preserve all current behavior.
MEDIA_WRITE_MODE=local
MEDIA_READ_MODE=local
MEDIA_KEEP_LOCAL_AFTER_PROMOTE=true
MEDIA_R2_WRITE_PAUSED=false
MEDIA_MUTATIONS_PAUSED=false
MEDIA_CDN_BASE_URL=https://media.ydp321.asia

R2_ACCOUNT_ID=
R2_BUCKET=coderx-media-public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_HARD_LIMIT_BYTES=7000000000
R2_RESUME_LIMIT_BYTES=6000000000

# Flow image runtime limits (enforced in code, not configurable here):
# - 9 files/post
# - 10MB/file
# - 30MB/selection
# - 40MP decoded limit
# - 3 concurrent client uploads
# - 7-day pending orphan TTL
