{
  "name": "coderx_server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/main.ts",
    "dev:socket": "NODE_ENV=development tsx watch ./src/socket_server.ts",
    "ingest": "NODE_ENV=development node --enable-source-maps ./dist/ingest/cli.js",
    "start": "NODE_ENV=production node --enable-source-maps ./dist/main.js",
    "start:ingest": "NODE_ENV=production node --enable-source-maps ./dist/ingest/worker.js",
    "start:socket": "NODE_ENV=production node --enable-source-maps ./dist/socket_server.js",
    "dev:cleanup": "NODE_ENV=development tsx ./src/tasks/cleanup.worker.ts",
    "start:cleanup": "NODE_ENV=production node --enable-source-maps ./dist/tasks/cleanup.worker.js",
    "media:migrate": "node --enable-source-maps ./dist/tasks/mediaMigration.cli.js",
    "test": "pnpm build && node --require ./test/support/runtime-guard.cjs --import=tsx --test --test-concurrency=1 \"test/service/*.test.ts\" \"test/tasks/*.test.ts\" \"test/controller/*.test.ts\" \"test/http/*.test.ts\"",
    "test:media-db": "node --import=tsx --test \"test/integration/*.postgres.test.ts\"",
    "prettier": "prettier --write .",
    "update:prettier": "git fetch https://github.com/yangdanping/prettier_config_repo.git main && git checkout FETCH_HEAD -- .prettierrc .prettierignore",
    "test:video-media": "node --require ./test/support/runtime-guard.cjs --import=tsx --test test/integration/videoPoster.ffmpeg.test.ts",
    "type-check": "tsc -p tsconfig.json",
    "build": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "test:hono": "pnpm build && node --require ./test/support/runtime-guard.cjs --import=tsx --test --test-concurrency=1 \"test/http/*.test.ts\" \"test/tasks/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@mozilla/readability": "^0.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "accepts": "1.3.8",
    "ai": "^7.0.99",
    "bcryptjs": "^3.0.3",
    "co-body": "6.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "encodeurl": "2.0.0",
    "escape-html": "1.0.3",
    "google-auth-library": "^11.0.2",
    "happy-dom": "^20.14.5",
    "hono": "4.13.17",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "log4js": "^6.9.1",
    "markdown-it": "^15.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.3",
    "type-is": "1.6.18",
    "validator": "^13.15.35",
    "xml2js": "0.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/accepts": "1.3.7",
    "@types/co-body": "6.1.3",
    "@types/encodeurl": "1.0.3",
    "@types/escape-html": "1.0.4",
    "@types/json-schema": "7.0.15",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/type-is": "1.6.7",
    "@types/validator": "13.15.10",
    "@types/xml2js": "0.4.14",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module"
}
